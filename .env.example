# Run: python scripts/init_env.py (generates random local credentials).
POSTGRES_DB=agents
POSTGRES_USER=agents
POSTGRES_PASSWORD=
API_KEYS_JSON={}
BROKER_TOKEN=
SANDBOX_CONCURRENCY=2
CODING_WORKER_CONCURRENCY=2

# Forge own decision loop. Default reuses normal Codex login; no API key required.
FORGE_PROVIDER=codex_bridge
# Optional direct model API: set FORGE_PROVIDER=openai_compatible and fill below.
FORGE_BASE_URL=
FORGE_API_KEY=
FORGE_MODEL=
FORGE_TOKEN_PARAMETER=max_completion_tokens

# Legacy LangGraph sample only. Forge uses the provider configuration above.
# This setting does not change Coding Agent execution or its displayed capacity.
AGENT_MODE=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2048

# Legacy graph concurrency; unrelated to actual Codex worker capacity.
API_REPLICAS=2
WORKER_COUNT=5
N_JOBS_PER_WORKER=10
HOST_PORT=2026
MOCK_DELAY_SECONDS=10
