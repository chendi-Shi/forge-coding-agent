@@ -0,0 +1,40 @@
+import math
+
+import pytest
+
+from boltons.statsutils import Stats
+
+
+@pytest.mark.parametrize('sign', [1, -1])
+@pytest.mark.parametrize('skewness,kurtosis,expected', [
+    (2.0, 3.0, 1),  # Exact c0 == 0 boundary.
+    (0.0, 3.0, 0),  # Normal.
+    (0.0, 2.0, 2),  # Symmetric Beta.
+    (0.0, 4.0, 7),  # Symmetric Type VII.
+    (1.0, 4.5, 3),  # Gamma.
+    (1.0, 3.0, 1),  # Ordinary Type I.
+    (3.0, 3.0, 4),  # k = 0.2 remains Type IV at default precision 0.
+    (math.sqrt(5.0), 3.0, 5),
+    (math.sqrt(4.5), 3.0, 6),
+])
+def test_pearson_families(sign, skewness, kurtosis, expected):
+    stats = Stats([0])
+    stats.skewness = sign * skewness
+    stats.kurtosis = kurtosis
+    assert stats.pearson_type == expected
+
+
+@pytest.mark.parametrize('skewness,kurtosis,precision,expected', [
+    (0.00001, 3.0001, 3, 0),
+    (1.0, 4.5001, 3, 3),
+    (math.sqrt(5.0001), 3.0, 3, 5),
+    (math.sqrt(5.0001), 3.0, 6, 4),
+    (2.0, 3.00001, 3, 1),
+    (2.0, 2.99999, 3, 6),
+])
+def test_pearson_rounding(skewness, kurtosis, precision, expected):
+    stats = Stats([0])
+    stats.skewness = skewness
+    stats.kurtosis = kurtosis
+    stats._pearson_precision = precision
+    assert stats.pearson_type == expected
